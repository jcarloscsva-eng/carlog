{
  "name": "carlog",
  "private": true,
  "workspaces": [
    "app",
    "cron-worker"
  ],
  "scripts": {
    "dev:app": "npm run dev --workspace app",
    "dev:pages": "wrangler pages dev app/dist --compatibility-date=2024-09-23",
    "dev:cron": "npm run dev --workspace cron-worker",
    "build:app": "npm run build --workspace app",
    "deploy:cron": "npm run deploy --workspace cron-worker"
  },
  "devDependencies": {
    "typescript": "^5.6.2",
    "wrangler": "^3.78.0",
    "@cloudflare/workers-types": "^4.20240925.0"
  }
}
