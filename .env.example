# --- Cloudflare Pages Functions (functions/api/**) y cron-worker ---------
# Configúralos como secrets, NO como variables planas en producción:
#   wrangler pages secret put AIRTABLE_API_KEY
#   wrangler pages secret put AIRTABLE_BASE_ID
#   (repite para el resto, y también dentro de cron-worker/ con `wrangler secret put`)

AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=

RESEND_API_KEY=

# Login propio con código por email (sustituye a Cloudflare Access)
# SESSION_SECRET: cadena aleatoria larga, p. ej. `openssl rand -hex 32`
SESSION_SECRET=
# ALLOWED_EMAILS: opcional, lista separada por comas. Si se deja vacío,
# cualquier email puede pedir un código (no recomendado en producción).
ALLOWED_EMAILS=

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu@email.com

APP_URL=https://carlog.pages.dev

# --- Frontend (app/.env.local) --------------------------------------------
# Solo la clave pública VAPID viaja al navegador.
VITE_VAPID_PUBLIC_KEY=
